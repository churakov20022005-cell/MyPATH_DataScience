DATABASE_URL=postgresql://mypath:change-local-db-password@localhost:5432/mypath
POSTGRES_DB=mypath
POSTGRES_USER=mypath
POSTGRES_PASSWORD=change-local-db-password
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-secret-at-least-32-characters
# Generate with: python -m flask --app app password-hash
ADMIN_PASSWORD_HASH='replace-with-generated-password-hash'
# Set true behind HTTPS in production.
COOKIE_SECURE=false
